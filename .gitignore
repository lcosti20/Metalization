# IDE and Compiler folders
.claude/
.vs/
.vscode/
.idea/
.consulo/
__pycache__/

# ---------------------------------------------------------------------------
# Unity
# ---------------------------------------------------------------------------
# Regenerated by the editor; never commit.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Bb]uild/
/[Bb]uilds/
/Windows/

# Asset Store tools and Rider plugin dropped into the project
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Addressables / Streaming assets build output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Debug symbol .meta files Unity generates
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and build artefacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app
mono_crash.*

# Gradle (Android builds)
.gradle/
ExportedObj/

# ---------------------------------------------------------------------------
# Unreal (legacy project, still in the repo during the rewrite)
# ---------------------------------------------------------------------------
DerivedDataCache/
Intermediate/
Saved/
Binaries/
Plugins/*/Binaries
Plugins/*/Intermediate

# ---------------------------------------------------------------------------
# Visual Studio / Rider (Unity and Unreal both regenerate these)
# ---------------------------------------------------------------------------
*.sln
*.slnx
*.csproj
*.unityproj
*.suo
*.user
*.userprefs
*.userosscache
*.sln.docstates
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp

# Compiled source code
*.com
*.class
*.dll
*.exe
*.o
*.obj

# Unity plugins ship as DLLs inside Assets/ and must be tracked.
!/[Aa]ssets/**/*.dll

# Pixabay licence certificates name the downloading account; keep them local.
/Art/Music/*-license.txt

# Blender backup files
*.blend[0-9]*

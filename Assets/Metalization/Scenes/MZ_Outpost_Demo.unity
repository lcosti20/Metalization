--- !u!114 &596056978
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 596056976}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 989c07a475d7b0d429e8bb02d328f0fd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Metalization::Metalization.MetalMission
  missionName: OUTPOST - THE GATE JOB
  objectives:
  - description: Scrap the enemy patrol in the courtyard
    type: 0
    targetTag: Squad1
    targetObject: {fileID: 0}
    startDialogue:
    - speaker: Guide
      line: Hey, you're awake! Enemy shooters are all over the courtyard. Go scrap 'em - I'll guard this extremely important crate.
      duration: 4.5
    - speaker: Guide
      line: WASD to move, mouse to aim, left click to shoot. 1-2 or the wheel swaps arms. G throws an EMP grenade.
      duration: 4.5
    - speaker: Guide
      line: And don't mind the hangar behind you. Those bots are on display. Like art. Expensive art.
      duration: 4.5
    hint: 
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Climb over the scrap wall
    type: 1
    targetTag: 
    targetObject: {fileID: 967100954}
    startDialogue:
    - speaker: Guide
      line: Nice shooting! Now get over that scrap heap. Robots don't get vertigo. Mostly.
      duration: 4.5
    - speaker: Guide
      line: Word is somebody stashed a Shotgun up on the pillar to the left. Finders keepers.
      duration: 4.5
    hint: 
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: 'Hijack a gate guard with the Hack Tether [F]'
    type: 3
    targetTag: GateGuard
    targetObject: {fileID: 0}
    startDialogue:
    - speaker: Guide
      line: Energy fence. You can't walk through it... but your Hack Tether can. Aim at a guard behind it and press F.
      duration: 4.5
    hint: 
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: 'Use the guard to open the gate console [E]'
    type: 2
    targetTag: 
    targetObject: {fileID: 1676457234}
    startDialogue:
    - speaker: Guide
      line: Ha! You're wearing an enemy shooter! Walk him over to the console and press E. Try to look... evil-ish.
      duration: 4.5
    - speaker: Guide
      line: When you let go with F he reboots and goes right back to their side. So don't let go next to him.
      duration: 4.5
    hint: 
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Destroy the Brute (or borrow it)
    type: 0
    targetTag: Boss
    targetObject: {fileID: 0}
    startDialogue:
    - speaker: Guide
      line: Gate's open! Uh. Oh. That's a Brute. Big guns, bigger attitude. Grab the rocket launcher...
      duration: 4.5
    - speaker: Guide
      line: ...or tether the big lug and give his buddies a taste of their own minigun.
      duration: 4.5
    hint: 
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Reach the extraction pad
    type: 1
    targetTag: 
    targetObject: {fileID: 671070385}
    startDialogue:
    - speaker: Guide
      line: That's how we do it at the outpost! Get to the extraction pad before the Warlord notices his gate is missing.
      duration: 4.5
    hint: 
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  completionDialogue:
  - speaker: Guide
    line: You magnificent pile of bolts. Drinks are on me. Oil. I mean oil.
    duration: 6
  playerStartingWeapons: []
  playerStartingGrenades: -1

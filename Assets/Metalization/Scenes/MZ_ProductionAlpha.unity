--- !u!114 &736760333
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 736760331}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 989c07a475d7b0d429e8bb02d328f0fd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Metalization::Metalization.MetalMission
  missionName: OPERATION REDLINE
  objectives:
  - description: Head for the supply trench
    type: 1
    targetTag: 
    targetObject: {fileID: 1831983439}
    startDialogue:
    - speaker: Command
      line: Morning, soldier. Blue Command here. The Reds dug into the valley overnight - today we take it back.
      duration: 5
    - speaker: Command
      line: 'Shake the rust off first: WASD to move, the mouse to look around. Head east to the supply trench.'
      duration: 5
    hint: '[W][A][S][D] move     [Mouse] look'
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Sprint through the trench
    type: 1
    targetTag: 
    targetObject: {fileID: 462746881}
    startDialogue:
    - speaker: Command
      line: Red mortars have that trench zeroed in. Hold Shift and SPRINT - don't stop for anything!
      duration: 5.5
    hint: Hold [Shift] to sprint
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Get over the barricades
    type: 1
    targetTag: 
    targetObject: {fileID: 1096860703}
    startDialogue:
    - speaker: Command
      line: Made it! Barricades ahead - Space to jump. Mind the ditch.
      duration: 5
    hint: '[Space] jump'
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Cross the collapsed bridge
    type: 1
    targetTag: 
    targetObject: {fileID: 582277031}
    startDialogue:
    - speaker: Command
      line: Bridge is out and the far side's higher. Jump, then hit Space again at the top - double jump!
      duration: 5.5
    hint: '[Space] jump, then [Space] again in mid-air'
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Ride the anti-grav lift up the cliff
    type: 1
    targetTag: 
    targetObject: {fileID: 1496710336}
    startDialogue:
    - speaker: Command
      line: Our forward post is up on the cliff. Step into the anti-grav lift and it'll carry you up.
      duration: 5
    hint: Walk into the glowing lift beam
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: 'Help the forward post: scrap the Red squad'
    type: 0
    targetTag: Squad1
    targetObject: {fileID: 0}
    startDialogue:
    - speaker: Command
      line: Our squad's dug in behind the sandbags. Push up and scrap those Reds. Left click shoots, right click aims.
      duration: 5
    - speaker: Command
      line: And grab that Repeater by the sandbags. 1 and 2, or the mouse wheel, swap your gun arm.
      duration: 5
    hint: '[LMB] shoot   [RMB] aim   [1][2] / wheel swap arm   [R] reload'
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Flush out the bunker
    type: 0
    targetTag: Bunker
    targetObject: {fileID: 0}
    startDialogue:
    - speaker: Command
      line: Bunker ahead. Those Reds are hunkered down behind the wall - only their heads show. Hard to hit.
      duration: 5
    - speaker: Command
      line: Grab the grenades and lob one on them - aim and press G. EMP stuns every robot in the blast. Then pick them off.
      duration: 5
    hint: Aim and press [G] to lob an EMP grenade - it stuns robots
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Sneak over to the robot dispenser and shut it down
    type: 2
    targetTag: 
    targetObject: {fileID: 530973793}
    startDialogue:
    - speaker: Command
      line: Patrol yard. See that machine by the north wall? A robot dispenser - scrap a Red and it welds a new one.
      duration: 5.5
    - speaker: Command
      line: 'So don''t fight. Hold Ctrl, or tap C, to crouch: you''re quiet and hard to see. Stay out of the lights.'
      duration: 5.5
    - speaker: Command
      line: Its off switch is the console against the wall right beside it. Sneak over and hit E. The pipe on your left gets you past the first guards.
      duration: 5.5
    - speaker: Command
      line: A question mark means one's getting curious. If one spots you, the whole yard comes running.
      duration: 5
    hint: Hold [Ctrl] / tap [C] to sneak     ? = suspicious     ! = spotted     [E] use the console
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Take the perch and grab the sniper rifle
    type: 1
    targetTag: 
    targetObject: {fileID: 1196670885}
    startDialogue:
    - speaker: Command
      line: Dispenser's dead. Whatever you scrap now stays scrapped. Ride the lift up that tower - there's a sniper rifle on the perch.
      duration: 5.5
    hint: Walk into the lift by the tower
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Snipe the Red marksmen in the valley
    type: 0
    targetTag: Marksmen
    targetObject: {fileID: 0}
    startDialogue:
    - speaker: Command
      line: Three Red marksmen are covering the valley from their towers. Hold right click to scope in.
      duration: 5
    - speaker: Command
      line: Watch for their red laser sights. Then take the ramp down to the valley floor.
      duration: 5
    hint: '[RMB] scope in   [LMB] fire   (the sniper is only accurate scoped)'
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Hack the gate guard
    type: 3
    targetTag: GateGuard
    targetObject: {fileID: 0}
    startDialogue:
    - speaker: Command
      line: Shield gate. Nothing gets through that field, not even your shots... but your Hack Tether does.
      duration: 5
    - speaker: Command
      line: Aim at that guard and press F. He's yours for half a minute - when you let go, he's theirs again.
      duration: 5
    hint: 'Aim at the guard behind the fence and press [F]'
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Open the gate from the console
    type: 2
    targetTag: 
    targetObject: {fileID: 1049185764}
    startDialogue:
    - speaker: Command
      line: You're driving a Red now. Walk him to the gate console and press E. Act natural.
      duration: 5
    - speaker: Command
      line: The other Reds won't look twice at one of their own - unless you start shooting.
      duration: 5
    hint: '[E] use the console     [F] let go'
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Destroy the Red commander
    type: 0
    targetTag: Boss
    targetObject: {fileID: 0}
    startDialogue:
    - speaker: Command
      line: Gate's open! Blue squad, go go go! Their commander's a Brute - bring it down and the valley's ours.
      duration: 5
    - speaker: Command
      line: There's a rocket launcher by the gate. Use the lift to the catwalk if you need the high ground.
      duration: 5
    hint: Rockets and EMP grenades work wonders on a Brute
    showMarker: 1
    completeDialogue:
    - speaker: Command
      line: The Brute's down! Their commander's scrap.
      duration: 5
    withNext: 1
    id: 
    requires: []
    checkpointOnComplete: 0
  - description: Shut down the robot dispensers
    type: 2
    targetTag: 
    targetObject: {fileID: 1195284366}
    startDialogue:
    - speaker: Command
      line: Heads up - their robot dispensers just powered on. They'll keep welding Reds until we shut them down.
      duration: 5.5
    - speaker: Command
      line: Their off switch is on the catwalk, past the marksman. Ride the lift up and hit it - Brute or no Brute.
      duration: 5.5
    hint: Take the lift to the catwalk     [E] use the console
    showMarker: 1
    completeDialogue:
    - speaker: Command
      line: Dispensers are offline. Whatever you scrap now stays scrapped.
      duration: 5
    withNext: 1
    id: Dispensers
    requires: []
    checkpointOnComplete: 1
  - description: Clear the command yard
    type: 0
    targetTag: Command
    targetObject: {fileID: 0}
    startDialogue:
    - speaker: Command
      line: Now sweep the yard - scrap every Red still standing.
      duration: 5
    hint: 
    showMarker: 1
    completeDialogue:
    - speaker: Command
      line: Yard's clean. Nice work.
      duration: 5
    withNext: 0
    id: 
    requires:
    - Dispensers
    checkpointOnComplete: 0
  - description: Reach the extraction pad
    type: 1
    targetTag: 
    targetObject: {fileID: 1295372366}
    startDialogue:
    - speaker: Command
      line: Commander, dispensers, yard - that's everything. Get to the extraction pad, soldier.
      duration: 5.5
    hint: 
    showMarker: 1
    completeDialogue: []
    withNext: 0
    id: 
    requires: []
    checkpointOnComplete: 0
  completionDialogue:
  - speaker: Command
    line: Outstanding work. The valley's ours. Blue Command out.
    duration: 6
  playerStartingWeapons:
  - {fileID: 11400000, guid: 8b49c71a36d5f844d906c69c81c747c2, type: 2}
  playerStartingGrenades: 0
